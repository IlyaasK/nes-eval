# Copy to .env and fill in the key(s) your agent needs.
# Compose auto-loads ./.env and passes these through to the task container.
# Anything left blank is fine — you only need the provider your agent talks to.

ANTHROPIC_API_KEY=
# Claude Code subscription login instead of an API key (`claude setup-token`).
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=
# Codex CLI reads CODEX_API_KEY in `codex exec`.
CODEX_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Used by run-agent.sh (see README.md). Command run inside the task
# container with the prompt as its last argument.
# AGENT_CMD=claude -p --dangerously-skip-permissions
